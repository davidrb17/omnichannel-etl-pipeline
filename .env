#============================================
# SQL Server
#============================================

DB_DRIVER="ODBC Driver 17 for SQL Server"
DB_SERVER=your_host
DB_NAME=app_db
DB_UID=your_user
DB_PWD=your_password
DB_ENCRYPT=no

#=============================================
# MySQL 
#=============================================

MYSQL_DRIVER="MySQL ODBC 9.5 Unicode Driver"
MYSQL_HOST=your_host
MYSQL_PORT=0000
MYSQL_DB=atm_db
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password

#===============================================
# PostgreSQL
#===============================================

PG_DRIVER="PostgreSQL ODBC Driver(UNICODE)"
PG_HOST=your_host
PG_PORT=0000 
PG_DB=web_db
PG_USER=your_user
PG_PASSWORD=your_password